# TR Board — copy to .env next to docker-compose.yml and fill in.

# REQUIRED. Postgres password; compose refuses to start without it.
# Note: Postgres only reads this when it first creates the data dir. To change
# it later, ALTER USER inside the DB as well.
POSTGRES_PASSWORD=

# Open self-sign-up. Default false: the first account becomes instance admin,
# after that admins create users (/admin) and invite them to workspaces.
ALLOW_REGISTRATION=false

# Where the bind mounts live (postgres/ and uploads/ are created inside).
# Unraid default shown; set e.g. ./data on another Docker host.
TRBOARD_DATA=/mnt/user/appdata/trboard

# --- Behind a reverse proxy (NGINX Proxy Manager, Cloudflare tunnel) ---
# Leave both empty when browsers reach the app directly on the LAN.
#
# TRUST_PROXY: which proxies may set X-Forwarded-For / X-Forwarded-Proto.
# Without it every request looks like it came from the proxy, so the login and
# public-form rate limits become one shared bucket, and https is never seen.
#   loopback,linklocal,uniquelocal   proxies on private addresses (Docker
#                                    networks, NPM on the same host). Usual pick.
#   1                                exactly one proxy hop in front of the app
#   10.1.1.5,172.18.0.0/16           specific proxy IPs / CIDRs
#   true                             trust any hop: only if the app port is not
#                                    reachable except through the proxy
TRUST_PROXY=
# COOKIE_SECURE: true = session cookie always Secure (https only). Set it when
# TLS ends at Cloudflare/NPM. Empty = Secure only when the request was https
# (needs TRUST_PROXY to see https through a proxy). false = never.
COOKIE_SECURE=

# --- Scheduled backups (optional) ---
# BACKUP_DIR is the path INSIDE the container; compose mounts
# ${TRBOARD_BACKUPS} (default ${TRBOARD_DATA}/backups) at /backups.
# Leave empty to turn scheduled backups off (Admin > Download backup still works).
BACKUP_DIR=
# Host folder for the backup files. On Unraid prefer an array share (e.g.
# /mnt/user/backups/trboard) over appdata, so a cache-pool failure can't take
# the database and its backups together.
TRBOARD_BACKUPS=
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7
# Largest archive the Admin restore upload accepts, in GB.
BACKUP_MAX_RESTORE_GB=50

# --- Single sign-on via OIDC (optional) ---
# All three of ISSUER, CLIENT_ID and REDIRECT_URI turn it on. The redirect URI
# is https://<your board>/api/auth/oidc/callback and must be registered at the
# provider exactly. See README "Single sign-on" for Authentik/Authelia/Google.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
# client_secret_basic (default) or client_secret_post: match the provider.
OIDC_TOKEN_AUTH_METHOD=
OIDC_SCOPES=openid email profile
OIDC_BUTTON_LABEL=Sign in with SSO
# Create accounts on first SSO login. Only works while ALLOW_REGISTRATION=true:
# with registration invite-only, SSO only signs in existing accounts.
OIDC_AUTO_PROVISION=false
# Allow an http:// issuer (LAN-only IdP or testing). Never for internet-facing.
OIDC_ALLOW_INSECURE_HTTP=false
